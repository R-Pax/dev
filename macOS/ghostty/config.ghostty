font-family = SFMono Nerd Font
# font-family = Acplus IBM EGA 8x14 
# font-family = IBM CP437 8x8 
font-size = 40

foreground = #C0B18B
background = #151515

palette = 0=#2f2f2f
palette = 1=#d75f5f
palette = 2=#d4d232
palette = 3=#af865a
palette = 4=#22c3a1
palette = 5=#775759
palette = 6=#84edb9
palette = 7=#c0b18b

background-image = ~/Documents/dev/macOS/ghostty/wolf.png
background-image-fit = cover
background-image-position = center
background-opacity = 0.6
background-blur=16

# window-decoration = none
macos-titlebar-style = hidden

# tmux

keybind = cmd+n=text:\x02c
keybind = cmd+t=text:\x02c
keybind = cmd+w=text:\x02W

keybind = cmd+k=text:clear\x0d

confirm-close-surface = false

# tmux next/previous window

keybind = ctrl+tab=text:\x02n
keybind = ctrl+shift+tab=text:\x02p

palette = 0=#2E2E2E
palette = 1=#D95E5C
palette = 2=#0BC4A1
palette = 3=#D4D313
palette = 4=#80EEB8
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#C0B289
