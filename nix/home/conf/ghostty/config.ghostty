# Font size in pixels
font-size = 30

shell-integration = zsh

# hide the macOS default title bar
macos-titlebar-style = hidden

# open new ghostty window 
keybind = super+n=new_window

# Cmd+S writes in nvim
keybind = super+s=text:\x1b[25~

# Catpuccin Mocha palette
foreground = #cdd6f4
background = #0d1117

# black
palette = 0=#45475a

# red
palette = 1=#f38ba8

# green
palette = 2=#a6e3a1

# yellow
palette = 3=#f9e2af

# blue
palette = 4=#89b4fa

# magenta
palette = 5=#f5c2e7

# cyan
palette = 6=#94e2d5

# white
palette = 7=#bac2de

# tmux settings, ghostty only manages keyboard shortcuts

# open new tmux window (tab)
keybind = ctrl+t=text:\x02c

# close tmux window (tab)
keybind = ctrl+w=text:\x02&

# cmd k to clear the terminal
keybind = ctrl+k=text:\x0c

# tmux next/previous window
keybind = ctrl+tab=text:\x02n
keybind = ctrl+shift+tab=text:\x02p

